+/*
+ * ppe/offload —— 估计硬件转发了多少流量。
+ *
+ * CPU-PPE 模式下没有可读的硬件包计数器：NPU 才维护 per-flow 计数
+ * （npu->stats 由固件写入），而我们不挂 NPU。可达的两个量是：
+ *   wire  端口 GDM MIB 计数，含被 PPE 直接转发、不经过 CPU 的帧
+ *   cpu   真正交付给协议栈（RX）或由 CPU 提交（TX）的帧，本补丁新增
+ * 两者之差就是硬件转发量。每个端口打印累计值与距上次读取的速率，
+ * 速率用 jiffies 增量归一化，取整到每秒。
+ */
+static int airoha_ppe_debugfs_offload_show(struct seq_file *m, void *private)
+{
+	struct airoha_ppe *ppe = m->private;
+	struct airoha_eth *eth = ppe->eth;
+	unsigned long now = jiffies;
+	int i, j;
+
+	seq_puts(m, "# port wire_rx cpu_rx hw_rx wire_tx cpu_tx hw_tx hw_pps\n");
+
+	for (i = 0; i < AIROHA_MAX_NUM_GDM_PORTS; i++) {
+		struct airoha_gdm_port *port = eth->ports[i];
+
+		if (!port)
+			continue;
+
+		for (j = 0; j < AIROHA_MAX_NUM_GDM_DEVS; j++) {
+			struct airoha_gdm_dev *dev = port->devs[j];
+			unsigned long dt;
+			u64 wire_rx, wire_tx, cpu_rx, cpu_tx, hw_rx, hw_tx;
+			u64 hw_pps = 0;
+			struct net_device *netdev;
+
+			if (!dev)
+				continue;
+
+			netdev = netdev_from_priv(dev);
+
+			airoha_gdm_update_hw_stats(dev);
+
+			wire_rx = READ_ONCE(dev->stats.rx_ok_pkts);
+			wire_tx = READ_ONCE(dev->stats.tx_ok_pkts);
+			cpu_rx = atomic64_read(&dev->cpu_stats.rx_pkts);
+			cpu_tx = atomic64_read(&dev->cpu_stats.tx_pkts);
+
+			hw_rx = wire_rx > cpu_rx ? wire_rx - cpu_rx : 0;
+			hw_tx = wire_tx > cpu_tx ? wire_tx - cpu_tx : 0;
+
+			dt = now - port->acc_prev.jiffies;
+			if (port->acc_prev.jiffies && dt) {
+				u64 d_wire = wire_rx > port->acc_prev.wire_rx ?
+					     wire_rx - port->acc_prev.wire_rx : 0;
+				u64 d_cpu = cpu_rx > port->acc_prev.cpu_rx ?
+					    cpu_rx - port->acc_prev.cpu_rx : 0;
+
+				if (d_wire > d_cpu)
+					hw_pps = div_u64((d_wire - d_cpu) * HZ, dt);
+			}
+			port->acc_prev.wire_rx = wire_rx;
+			port->acc_prev.wire_tx = wire_tx;
+			port->acc_prev.cpu_rx = cpu_rx;
+			port->acc_prev.cpu_tx = cpu_tx;
+			port->acc_prev.jiffies = now;
+
+			seq_printf(m, "%-10s wire_rx=%llu cpu_rx=%llu hw_rx=%llu"
+				      " wire_tx=%llu cpu_tx=%llu hw_tx=%llu"
+				      " hw_pps=%llu\n",
+				   netdev ? netdev_name(netdev) : "?", wire_rx, cpu_rx, hw_rx,
+				   wire_tx, cpu_tx, hw_tx, hw_pps);
+		}
+	}
+
+	return 0;
+}
+
+static int airoha_ppe_debugfs_offload_open(struct inode *inode,
+					   struct file *file)
+{
+	return single_open(file, airoha_ppe_debugfs_offload_show,
+			   inode->i_private);
+}
+
+static const struct file_operations airoha_ppe_debugfs_offload_fops = {
+	.owner = THIS_MODULE,
+	.open = airoha_ppe_debugfs_offload_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
