+static void airoha_ppe_fe_update_bits(struct airoha_eth *eth, u32 offset,
+				      u32 mask, u32 val)
+{
+	airoha_fe_rmw(eth, offset, mask, val & mask);
+}
+
+static void airoha_ppe_an7581_config_proto_filter(struct airoha_eth *eth)
+{
+	int i, f;
+
+	for (i = 0; i < eth->soc->num_ppe; i++) {
+		for (f = 0; f < 4; f++)
+			airoha_fe_wr(eth, REG_PPE_IP_PROTO_FILTER(i, f), 0);
+
+		airoha_fe_wr(eth, REG_PPE_IP_PROTO_CHK(i),
+			     PPE_IP_PROTO_CHK_BLACKLIST);
+		airoha_fe_set(eth, REG_PPE_PPE_FLOW_CFG(i),
+			      PPE_FLOW_CFG_IP_PROTO_BLACKLIST_MASK);
+		airoha_fe_wr(eth, REG_PPE_IP_PROTO_FILTER(i, 0),
+			     PPE_IP_PROTO_FILTER0_BLACKLIST);
+		airoha_ppe_fe_update_bits(eth, REG_PPE_IP_PROTO_FILTER(i, 1),
+					  GENMASK(15, 0),
+					  PPE_IP_PROTO_FILTER1_BLACKLIST);
+	}
+}
+
+static void airoha_ppe_an7581_config_tpid_entry(struct airoha_eth *eth,
+						u32 index, bool enable,
+						u16 value)
+{
+	u32 enable_bit = BIT(index);
+	u32 shift = (index & 1) * 16;
+	u32 mask = 0xffffU << shift;
+	int i;
+
+	for (i = 0; i < eth->soc->num_ppe; i++) {
+		airoha_ppe_fe_update_bits(eth, REG_PPE_TPID_EN(i), enable_bit,
+					  enable ? enable_bit : 0);
+		airoha_ppe_fe_update_bits(eth, REG_PPE_TPID_VAL(i, index >> 1),
+					  mask, (u32)value << shift);
+	}
+}
+
+static void airoha_ppe_an7581_config_tpid(struct airoha_eth *eth)
+{
+	u32 ethertype = airoha_fe_rr(eth, REG_FE_DMA_GLO_CFG) >> 16;
+	int i;
+
+	for (i = 0; i < eth->soc->num_ppe; i++)
+		airoha_fe_wr(eth, REG_PPE_TPID_CFG(i), PPE_TPID_CFG_DEFAULT);
+
+	airoha_ppe_an7581_config_tpid_entry(eth, 0, true, ETH_P_8021Q);
+	airoha_ppe_an7581_config_tpid_entry(eth, 1, true, ETH_P_8021AD);
+	if (ethertype != ETH_P_8021Q && ethertype != ETH_P_8021AD)
+		airoha_ppe_an7581_config_tpid_entry(eth, 2, true, ethertype);
+
+	airoha_ppe_an7581_config_tpid_entry(eth, 3, true, ETH_P_IP);
+	airoha_ppe_an7581_config_tpid_entry(eth, 4, true, ETH_P_IPV6);
+}
+
+static void airoha_ppe_an7581_config_policy(struct airoha_eth *eth)
+{
+	static const u32 policy[] = {
+		0x07d407d0,
+		0x07dc07d8,
+		0x07e407e0,
+		0x000007e8,
+	};
+	int i, j;
+
+	for (i = 0; i < eth->soc->num_ppe; i++) {
+		for (j = 0; j < ARRAY_SIZE(policy); j++)
+			airoha_fe_wr(eth, REG_PPE_MTU_BASE(i) + (j << 2),
+				     policy[j]);
+	}
+}
+
+static void airoha_ppe_an7581_config_flow_type(struct airoha_eth *eth)
+{
+	int i;
+
+	for (i = 0; i < eth->soc->num_ppe; i++)
+		airoha_ppe_fe_update_bits(
+			eth, REG_PPE_PPE_FLOW_CFG(i),
+			(u32)~PPE_FLOW_CFG_IP_PROTO_BLACKLIST_MASK,
+			PPE_FLOW_CFG_TYPE3_INIT);
+}
+
+static void airoha_ppe_an7581_config_table_hash(struct airoha_eth *eth,
+						bool ppe2_was_enabled)
+{
+	u32 table_count = FIELD_PREP(PPE_SRAM_TB_NUM_ENTRY_MASK,
+				     ppe2_was_enabled ? 3 : 4);
+	int i;
+
+	for (i = 0; i < eth->soc->num_ppe; i++)
+		airoha_ppe_fe_update_bits(eth, REG_PPE_TB_HASH_CFG(i),
+					  0x00010101, 0x00000101);
+
+	airoha_ppe_fe_update_bits(eth, REG_PPE_TB_CFG(0),
+				  PPE_SRAM_TB_NUM_ENTRY_MASK, table_count);
+	if (ppe2_was_enabled && eth->soc->num_ppe > 1)
+		airoha_ppe_fe_update_bits(eth, REG_PPE_TB_CFG(1),
+					  PPE_SRAM_TB_NUM_ENTRY_MASK,
+					  table_count);
+
+	airoha_ppe_fe_update_bits(eth, REG_PPE_TB_CFG(0),
+				  PPE_DRAM_TB_NUM_ENTRY_MASK, 6);
+
+	for (i = 0; i < eth->soc->num_ppe; i++) {
+		airoha_fe_clear(eth, REG_PPE_TB_HASH_CFG(i),
+				PPE_SRAM_HASH0_MODE_MASK);
+		airoha_fe_set(eth, REG_PPE_TB_HASH_CFG(i),
+			      FIELD_PREP(PPE_SRAM_HASH1_MODE_MASK, 1));
+		airoha_fe_clear(eth, REG_PPE_TB_HASH_CFG(i),
+				PPE_DRAM_HASH0_MODE_MASK);
+		if (!i || ppe2_was_enabled)
+			airoha_ppe_fe_update_bits(
+				eth, REG_PPE_TB_HASH_CFG(i),
+				PPE_DRAM_HASH1_MODE_MASK,
+				FIELD_PREP(PPE_DRAM_HASH1_MODE_MASK, 3));
+
+		airoha_fe_wr(eth, REG_PPE_HASH_SEED(i), PPE_HASH_SEED);
+		airoha_fe_clear(eth, REG_PPE_TB_CFG(i),
+				PPE_TB_ENTRY_SIZE_MASK);
+		airoha_fe_set(eth, REG_PPE_TB_CFG(i),
+			      FIELD_PREP(PPE_TB_CFG_SEARCH_MISS_MASK, 3));
+	}
+}
+
+static void airoha_ppe_an7581_config_aging(struct airoha_eth *eth)
+{
+	int i;
+
+	for (i = 0; i < eth->soc->num_ppe; i++) {
+		airoha_fe_set(eth, REG_PPE_TB_CFG(i),
+			      PPE_TB_CFG_AGE_EN_MASK |
+			      PPE_TB_CFG_KEEPALIVE_MASK);
+		airoha_ppe_fe_update_bits(eth, REG_PPE_UNBIND_AGE(i),
+					  0xffff00ff, 0x03e80003);
+		airoha_ppe_fe_update_bits(eth, REG_PPE_BND_AGE0(i),
+					  0x7fff7fff, 0x000f003c);
+		airoha_ppe_fe_update_bits(eth, REG_PPE_BND_AGE1(i),
+					  0x7fff7fff, 0x0005003c);
+		airoha_fe_wr(eth, REG_PPE_KEEPALIVE(i), 0x01010001);
+		airoha_ppe_fe_update_bits(eth, REG_PPE_BIND_LIMIT0(i),
+					  0x3fff3fff, 0x0fa00fa0);
+		airoha_ppe_fe_update_bits(eth, REG_PPE_BIND_LIMIT1(i),
+					  0x00ff3fff, 0x00011f40);
+		airoha_fe_wr(eth, REG_PPE_BIND_RATE(i), 0x001e001e);
+	}
+}
+
+static void airoha_ppe_an7581_config_global_enable(struct airoha_eth *eth)
+{
+	int i;
+
+	for (i = 0; i < eth->soc->num_ppe; i++) {
+		airoha_ppe_fe_update_bits(eth, REG_PPE_GLO_CFG(i),
+					  PPE_GLO_CFG_FEAT_CLR_MASK |
+					  PPE_GLO_CFG_INIT_FEAT_MASK,
+					  PPE_GLO_CFG_INIT_FEAT_MASK);
+		airoha_fe_set(eth, REG_PPE_GLO_CFG(i),
+			      PPE_GLO_CFG_SRAM_EN_MASK);
+		airoha_fe_set(eth, REG_PPE_GLO_CFG(i), PPE_GLO_CFG_EN_MASK);
+		airoha_fe_set(eth, REG_PPE_PPE_FLOW_CFG(i),
+			      PPE_FLOW_CFG_IP6_HASH_GRE_KEY_MASK |
+			      (i ? PPE_FLOW_CFG_IP4_HASH_GRE_KEY_MASK : 0));
+		airoha_fe_set(eth, REG_PPE_GLO_CFG(i),
+			      PPE_GLO_CFG_TABLE_FEAT_MASK);
+		airoha_ppe_fe_update_bits(
+			eth, REG_PPE_PPE_FLOW_CFG(i),
+			PPE_FLOW_CFG_FINAL_CLR_MASK |
+			PPE_FLOW_CFG_IP4_HASH_GRE_KEY_MASK,
+			PPE_FLOW_CFG_IP4_HASH_GRE_KEY_MASK);
+	}
+}
+
+static void airoha_ppe_an7581_hw_init(struct airoha_eth *eth)
+{
+	bool ppe2_was_enabled;
+	int i;
+
+	airoha_fe_set(eth, REG_PPE_GLO_CFG(0), PPE_GLO_CFG_PSE_HASH_OFS_MASK);
+	airoha_ppe_fe_update_bits(eth, REG_PPE_TB_CFG(0),
+				  PPE_TB_CFG_ENTRY_CNT_CLR_MASK |
+				  PPE_TB_CFG_KEEPALIVE_MASK,
+				  PPE_TB_CFG_KEEPALIVE_MASK);
+	if (eth->soc->num_ppe > 1) {
+		airoha_fe_set(eth, REG_PPE_GLO_CFG(1),
+			      PPE_GLO_CFG_PSE_HASH_OFS_MASK);
+		airoha_ppe_fe_update_bits(eth, REG_PPE_TB_CFG(1),
+					  PPE_TB_CFG_ENTRY_CNT_CLR_MASK |
+					  PPE_TB_CFG_PPE2_ENTRY_CNT_MASK |
+					  PPE_TB_CFG_KEEPALIVE_MASK,
+					  PPE_TB_CFG_PPE2_ENTRY_CNT_MASK |
+					  PPE_TB_CFG_KEEPALIVE_MASK);
+	}
+	ppe2_was_enabled = airoha_ppe_is_enabled(eth, 1);
+
+	airoha_ppe_an7581_config_proto_filter(eth);
+	airoha_ppe_an7581_config_tpid(eth);
+	airoha_ppe_an7581_config_policy(eth);
+	airoha_ppe_an7581_config_flow_type(eth);
+	airoha_ppe_an7581_config_table_hash(eth, ppe2_was_enabled);
+	airoha_ppe_an7581_config_aging(eth);
+	airoha_ppe_an7581_config_global_enable(eth);
+
+	for (i = 0; i < eth->soc->num_ppe; i++)
+		airoha_fe_wr(eth, REG_PPE_DFT_CPORT_BASE(i), 0x00000500);
+}
+
+static void airoha_ppe_an7581_hw_deinit(struct airoha_eth *eth)
+{
+	u32 flow_cfg;
+	int i;
+
+	for (i = 0; i < eth->soc->num_ppe; i++) {
+		airoha_fe_wr(eth, REG_PPE_DFT_CPORT_BASE(i), 0x00000500);
+		airoha_fe_clear(eth, REG_PPE_GLO_CFG(i), PPE_GLO_CFG_EN_MASK);
+		airoha_fe_clear(eth, REG_PPE_GLO_CFG(i),
+				PPE_GLO_CFG_INIT_FEAT_MASK);
+		airoha_fe_clear(eth, REG_PPE_GLO_CFG(i),
+				PPE_GLO_CFG_SRAM_EN_MASK);
+		airoha_fe_clear(eth, REG_PPE_GLO_CFG(i),
+				PPE_GLO_CFG_TTL_DROP_MASK);
+		airoha_fe_set(eth, REG_PPE_GLO_CFG(i),
+			      PPE_GLO_CFG_IP4_CS_DROP_MASK |
+			      PPE_GLO_CFG_IP4_L4_CS_DROP_MASK);
+		airoha_fe_clear(eth, REG_PPE_GLO_CFG(i),
+				PPE_GLO_CFG_TABLE_FEAT_MASK);
+	}
+
+	flow_cfg = airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(0)) &
+		   PPE_FLOW_CFG_IP_PROTO_BLACKLIST_MASK;
+	for (i = 0; i < eth->soc->num_ppe; i++) {
+		airoha_fe_wr(eth, REG_PPE_PPE_FLOW_CFG(i), flow_cfg);
+		airoha_fe_clear(eth, REG_PPE_TB_CFG(i),
+				PPE_TB_CFG_AGE_EN_MASK);
+	}
+}
