#!/bin/sh /etc/rc.common
# fttrd is fail-closed about the optical state: if it queries the FPGA
# before the h3c-fmcs driver finished loading, the PON MAC TX readback
# returns 0, the daemon keeps its state "unknown" and refuses to transmit
# until an explicit reload ("optical state is unconfirmed ... explicit
# reload required"). rcS starts fttrd at S80 while FMCS probes around the
# same time, so nudge the state once the hardware is really up.
START=99
STOP=10

boot() {
	(
		i=0
		while [ "$i" -lt 40 ]; do
			i=$((i + 1))
			[ -e /dev/fmcs_mci ] || { sleep 1; continue; }
			st=$(fttrctl optical status 2>/dev/null | sed -n "s/.*\"actor_state\":\"\([a-z]*\)\".*/\1/p")
			case "$st" in
			enabled) exit 0 ;;
			esac
			fttrctl optical reload >/dev/null 2>&1
			sleep 2
			st=$(fttrctl optical status 2>/dev/null | sed -n "s/.*\"actor_state\":\"\([a-z]*\)\".*/\1/p")
			case "$st" in
			enabled) logger -t fttr-optical "optical state enabled after reload"; exit 0 ;;
			esac
			sleep 1
		done
		logger -t fttr-optical "optical state still not enabled after retries"
	) &
}
