#!/bin/sh
# H3C HM2004-DU 四核亲和触发器（默认关闭）
#
# 实测说明：本机的 WiFi 硬中断（PCIe INTx/MSI）被内核拒绝迁移，
# NAPI 线程挪到其他核会引入跨核开销；与 packet_steering 服务抢
# RPS 设置也会互相覆盖。在 HM2004-DU 上实测无收益、部分场景更低。
# 因此默认不启用，需要时手动开启：
#     touch /etc/npu-affinity.enable && /usr/sbin/pin-wifi-cpus.sh
# 关闭：rm /etc/npu-affinity.enable
[ "$ACTION" = "add" ] || exit 0
[ -e /etc/npu-affinity.enable ] || exit 0

case "$DEVICENAME" in
	phy*-ap0)
		/usr/sbin/pin-wifi-cpus.sh
		;;
esac

exit 0
