/*
 * H3C HM2004-DU —— WiFi→PON 硬件转发（NPU RX 卸载）叠加层
 *
 * ============================================================
 * MT7916 legacy ABI 版（step 2）：firmware-name + legacy boot
 * ============================================================
 *
 * 背景（实机实测，2026-11-19 → 2026-11-26）：
 *   2026-11-19 保守版实测：当前固件 NPU 用上游标准流程就能正常启动
 *   （fw version 1456.62 / npu_attached: 1 / 0 次超时），但那加载的是
 *   驱动内置名 en7581_npu_rv32.bin（120KB MT7992 通用版）。
 *   2026-11-26 首次 NPU 试验：dtsi 换成 ClankerNPU MT7916 专用固件
 *   （en7581_MT7916_npu_*.bin）却没设 legacy 属性 → 驱动仍走 mainline
 *   boot（MIB/BOOT_BASE/版本握手都是 mainline 固件期望的）→ legacy
 *   固件起不来（启动日志只见超时警告）→ mt7915 NPU RX 全断、WiFi
 *   客户端 0 关联。回滚后 WiFi 立即恢复。
 *
 *   MT7916 专用固件必须配 airoha,legacy-wlan-mailbox：
 *     401 补丁据此走 legacy boot（BOOT_CONFIG=0 + TRIGGER 0->1），
 *     跳过 MIB/BOOT_BASE 与版本握手（fw_version ENODATA 属预期）。
 *
 * 固件来源：ClankerNPU（ClankerConstruction/ClankerNPU，
 *   SOC=AN7581 WIFI=MT7916）现编的 rv32 + data 一对。
 *
 * 内存布局依据原厂 QWRT 固件 DTB（见 reverse-out/board.dts）：
 *   npu-pkt @0x81000000  22MB   —— 与原厂同址
 *   npu-ba  @0x90c06800   2MB   —— 与原厂同址
 * 上游 en7581.dtsi 已占用 0x80000000(atf) / 0x84000000(npu-binary)
 * / 0x87000000(qdma0) / 0x89000000(qdma1)，0x81000000 空闲可安全占用。
 */

/ {
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		npu_pkt: npu-pkt@81000000 {
			no-map;
			reg = <0x0 0x81000000 0x0 0x1600000>;
		};

		npu_ba: npu-ba@90c06800 {
			no-map;
			reg = <0x0 0x90c06800 0x0 0x200000>;
		};
	};
};

/*
 * NPU 节点：只追加两个内存区，其余保持上游默认。
 *
 * memory-region 顺序必须与 memory-region-names 对应；
 * 上游驱动用 of_reserved_mem_region_to_resource_byname() 按名字取，
 * 所以顺序不敏感，但保持 binary 在首位与原厂一致。
 */
&npu {
	status = "okay";

	memory-region = <&npu_binary>, <&npu_pkt>, <&npu_ba>;
	memory-region-names = "binary", "pkt", "ba";

	/*
	 * ClankerNPU 现编的 AN7581+MT7916(kite) 固件。
	 * 上游驱动内置名 en7581_npu_rv32.bin 是 MT7992 通用版，
	 * 不含 kite 数据通路，必须显式指定这一对。
	 * data 进 NPU 局部 SRAM，rv32 进 npu-binary 区。
	 */
	firmware-name = "airoha/en7581_MT7916_npu_rv32.bin",
			"airoha/en7581_MT7916_npu_data.bin";

	/*
	 * MT7916 专用固件（en7581_MT7916_npu_*.bin）是 legacy WLAN mailbox
	 * ABI：由 401 补丁（airoha,legacy-wlan-mailbox → airoha_npu_legacy_
	 * boot）以 BOOT_CONFIG=0 + TRIGGER 0->1 脉冲启动，跳过 MIB/BOOT_BASE
	 * 配置、跳过版本握手（fw_version sysfs 读 ENODATA 属预期）。
	 *
	 * 实机验证（2026-11-19，保守版无此属性）：
	 *   缺此属性时驱动走 mainline boot（MIB/BOOT_BASE 是 mainline
	 *   固件期望的），legacy 固件起不来 → mt7915 NPU RX 全断、
	 *   WiFi 客户端 0 关联。加上后驱动走 legacy boot，与固件匹配。
	 */
	airoha,legacy-wlan-mailbox;
};
