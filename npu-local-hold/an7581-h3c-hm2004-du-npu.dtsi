/*
 * H3C HM2004-DU —— AN7581 NPU 保留内存叠加层
 *
 * 硬件转发本体由 990-01 / 990-02 / 991 三个内核补丁提供：
 *   · wed0/wed1、wdma0/wdma1 节点以及 &eth 的 airoha,wed 引用
 *     都由 990 补丁直接写进 target/linux/airoha/dts/an7581.dtsi。
 *     这里不要再重复定义——同 /soc 下同名节点会撞 reg 与中断。
 *   · PPE 由 991 在 AN7581 上改由 CPU 直接初始化（hw_initialized），
 *     不再依赖 NPU 完成 PPE 初始化。
 *
 * 因此本文件只剩两件事：
 *   1) NPU 固件的保留内存（pkt / ba；binary 由基座 dtsi 提供）
 *   2) &npu 的固件名与内存区名
 *
 * 内存布局沿用本机已验证可正常启动的方案：
 *   npu-pkt @0x81000000 22MB、npu-ba @0x90c06800 2MB。
 * 参考实现把这两块挪到 0x9e000000/0x9e800000，是为了避开 U-Boot 的
 * loadaddr 0x85000000；本机当前布局实测无冲突，暂不改动。若 NPU
 * probe 报内存异常，第一步就照抄成 0x9e000000/0x9e800000。
 */

/ {
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		npu_pkt: npu-pkt@81000000 {
			no-map;
			reg = <0x0 0x81000000 0x0 0x1600000>;
		};

		npu_ba: npu-ba@90c06800 {
			no-map;
			reg = <0x0 0x90c06800 0x0 0x200000>;
		};
	};
};

&npu {
	status = "okay";

	memory-region = <&npu_binary>, <&npu_pkt>, <&npu_ba>;
	memory-region-names = "binary", "pkt", "ba";

	/* 厂商 98K 固件（files/lib/firmware/airoha/ 随镜像打包） */
	firmware-name = "airoha/en7581_MT7916_npu_rv32.bin",
			"airoha/en7581_MT7916_npu_data.bin";
};
