#include <dt-bindings/interrupt-controller/arm-gic.h>
/*
 * H3C HM2004-DU —— AN7581 WED v1 TX + MT7916 NPU RX 叠加层
 *
 * 来源：wuziwei/ponwrt-ZN504-HG5585F 分支
 *       feat/hg5585f-wed-npu-offload-6.18（target/linux/airoha/dts/
 *       an7581-npu-mt7916.dtsi，提交 c8fc3037）。
 *
 * 本机（H3C HM2004-DU）与该分支的 HG5585F 同为 AN7581 + MT7916，
 * 因此 WED0/WED1、WDMA0/WDMA1 的寄存器地址与 GIC 中断号完全一致，
 * 可以原样复用；仅 reserved-memory 沿用本机已验证能正常启动的布局
 * （npu-pkt@0x81000000 / npu-ba@0x90c06800）。
 *
 * 分工（对方实测）：
 *   B1 下行（PON→WiFi）：WED v1 TX，PPE → PSE port3 → WDMA → WED
 *   B2 上行（WiFi→PON）：厂商 98K MT7916 RX-only NPU 固件 + hostadpt 环
 *
 * 与旧版本的差别：不再需要 airoha,legacy-wlan-mailbox，也不再走我们
 * 自研的 402/405 mt76 补丁；RX 语义由 airoha,npu-mt7916-rx 触发。
 */

/ {
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		npu_pkt: npu-pkt@81000000 {
			no-map;
			reg = <0x0 0x81000000 0x0 0x1600000>;
		};

		npu_ba: npu-ba@90c06800 {
			no-map;
			reg = <0x0 0x90c06800 0x0 0x200000>;
		};
	};
};

&npu {
	status = "okay";

	memory-region = <&npu_binary>, <&npu_pkt>, <&npu_ba>;
	memory-region-names = "binary", "pkt", "ba";

	/* 厂商 98K RX-only 固件（files/lib/firmware/airoha/ 随镜像打包） */
	firmware-name = "airoha/en7581_MT7916_npu_rv32.bin",
			"airoha/en7581_MT7916_npu_data.bin";

	/* 启用 MT7916 RX-only 模式：hostadpt 环接管 WiFi 接收 */
	airoha,npu-mt7916-rx;
};

&{/soc} {
	wdma0: wdma@1fa06000 {
		compatible = "airoha,an7581-wdma";
		reg = <0x0 0x1fa06000 0x0 0x400>;
		interrupts = <GIC_SPI 69 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 70 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 71 IRQ_TYPE_LEVEL_HIGH>;
		status = "okay";
	};

	wdma1: wdma@1fa06400 {
		compatible = "airoha,an7581-wdma";
		reg = <0x0 0x1fa06400 0x0 0x400>;
		interrupts = <GIC_SPI 72 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 73 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 74 IRQ_TYPE_LEVEL_HIGH>;
		status = "okay";
	};

	wed0: wed@1fa02000 {
		compatible = "airoha,an7581-wed";
		reg = <0x0 0x1fa02000 0x0 0xb00>;
		interrupts = <GIC_SPI 67 IRQ_TYPE_LEVEL_HIGH>;
		airoha,wdma = <&wdma0>;
		airoha,wed-id = <0>;
		status = "okay";
	};

	wed1: wed@1fa03000 {
		compatible = "airoha,an7581-wed";
		reg = <0x0 0x1fa03000 0x0 0xb00>;
		interrupts = <GIC_SPI 68 IRQ_TYPE_LEVEL_HIGH>;
		airoha,wdma = <&wdma1>;
		airoha,wed-id = <1>;
		status = "okay";
	};
};

&eth {
	airoha,wed = <&wed0>, <&wed1>;
};
